<?xml version="1.0"?>
<!--
  Celda de trabajo robx7 (Sesion 1, Unidad 6.1)
  Convencion: el origen del mundo de Gazebo coincide con el marco 'world' de ROS
  (base del robot, a nivel de la superficie de la mesa, z = 0).

  Distribucion (vista superior, x hacia adelante, y a la izquierda):
     - Zona de entrada : centro (0.70, 0.00), cuadro de 0.30 x 0.30 m
     - Destinos        : rojo (0.50, 0.50), verde (0.50, -0.50), azul (0.00, 0.70)
     - Objetos         : cubo rojo, cilindro verde, cubo azul dentro de la zona de entrada
-->
<sdf version="1.8">
  <world name="robx7_cell">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Sistemas de Gazebo Fortress. 'Sensors' es OBLIGATORIO para que la camara genere imagenes -->
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.8 0.85 0.9 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 5 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.2 -1</direction>
    </light>

    <!-- Piso (0.75 m debajo de la superficie de la mesa) -->
    <model name="floor">
      <static>true</static>
      <pose>0 0 -0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
          <material>
            <ambient>0.55 0.55 0.55 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Mesa: superficie en z = -0.001 (1 mm bajo la base del robot) -->
    <model name="table">
      <static>true</static>
      <link name="link">
        <collision name="top_collision">
          <pose>0.45 0 -0.021 0 0 0</pose>
          <geometry><box><size>1.3 1.7 0.04</size></box></geometry>
        </collision>
        <visual name="top_visual">
          <pose>0.45 0 -0.021 0 0 0</pose>
          <geometry><box><size>1.3 1.7 0.04</size></box></geometry>
          <material>
            <ambient>0.75 0.62 0.45 1</ambient>
            <diffuse>0.75 0.62 0.45 1</diffuse>
          </material>
        </visual>
        <!-- Patas (solo visuales) -->
        <visual name="leg1"><pose>-0.15 0.8 -0.40 0 0 0</pose>
          <geometry><box><size>0.05 0.05 0.72</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual>
        <visual name="leg2"><pose>-0.15 -0.8 -0.40 0 0 0</pose>
          <geometry><box><size>0.05 0.05 0.72</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual>
        <visual name="leg3"><pose>1.05 0.8 -0.40 0 0 0</pose>
          <geometry><box><size>0.05 0.05 0.72</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual>
        <visual name="leg4"><pose>1.05 -0.8 -0.40 0 0 0</pose>
          <geometry><box><size>0.05 0.05 0.72</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Marcas visuales (sin colision): zona de entrada y destinos -->
    <model name="zones">
      <static>true</static>
      <link name="link">
        <visual name="input_zone">
          <pose>0.70 0.0 0.0005 0 0 0</pose>
          <geometry><box><size>0.30 0.30 0.001</size></box></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
        </visual>
        <visual name="bin_red">
          <pose>0.50 0.50 0.0005 0 0 0</pose>
          <geometry><box><size>0.14 0.14 0.001</size></box></geometry>
          <material><ambient>0.6 0.1 0.1 1</ambient><diffuse>0.6 0.1 0.1 1</diffuse></material>
        </visual>
        <visual name="bin_green">
          <pose>0.50 -0.50 0.0005 0 0 0</pose>
          <geometry><box><size>0.14 0.14 0.001</size></box></geometry>
          <material><ambient>0.1 0.5 0.1 1</ambient><diffuse>0.1 0.5 0.1 1</diffuse></material>
        </visual>
        <visual name="bin_blue">
          <pose>0.00 0.70 0.0005 0 0 0</pose>
          <geometry><box><size>0.14 0.14 0.001</size></box></geometry>
          <material><ambient>0.1 0.1 0.6 1</ambient><diffuse>0.1 0.1 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Objetos (dinamicos, para poder tomarlos en sesiones posteriores) -->
    <model name="cube_red">
      <pose>0.66 0.08 0.02 0 0 0.3</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia><ixx>1.33e-5</ixx><iyy>1.33e-5</iyy><izz>1.33e-5</izz></inertia>
        </inertial>
        <collision name="collision"><geometry><box><size>0.04 0.04 0.04</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <material><ambient>0.9 0.05 0.05 1</ambient><diffuse>0.9 0.05 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="cylinder_green">
      <pose>0.74 -0.07 0.025 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia><ixx>1.5e-5</ixx><iyy>1.5e-5</iyy><izz>1.0e-5</izz></inertia>
        </inertial>
        <collision name="collision"><geometry><cylinder><radius>0.02</radius><length>0.05</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.02</radius><length>0.05</length></cylinder></geometry>
          <material><ambient>0.05 0.8 0.05 1</ambient><diffuse>0.05 0.8 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="cube_blue">
      <pose>0.64 -0.14 0.02 0 0 -0.5</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia><ixx>1.33e-5</ixx><iyy>1.33e-5</iyy><izz>1.33e-5</izz></inertia>
        </inertial>
        <collision name="collision"><geometry><box><size>0.04 0.04 0.04</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <material><ambient>0.05 0.05 0.9 1</ambient><diffuse>0.05 0.05 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
