<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="gripper_base_length" value="0.1"/>
    <xacro:property name="gripper_base_width" value="0.05"/>
    <xacro:property name="gripper_base_height" value="0.02"/>
    <xacro:property name="gripper_finger_length" value="0.05"/>
    <xacro:property name="gripper_finger_width" value="0.02"/>
    <xacro:property name="gripper_finger_height" value="0.02"/>

    <link name="gripper_base">
        <visual>
            <origin xyz="0 0 0" rpy="0.0 0.0 0.0"/>
            <geometry>  
                <box size="${gripper_base_length} ${gripper_base_width} ${gripper_base_height}"/>
            </geometry>
            <material name="gray"/>
        </visual>
    </link>

    <link name="gripper_finger_left">
        <visual>
            <origin xyz="${gripper_finger_length/2} 0 0" rpy="0.0 0.0 0.0"/>
            <geometry>  
                <box size="${gripper_finger_length} ${gripper_finger_width} ${gripper_finger_height}"/>
            </geometry>
            <material name="blue"/>
        </visual>
    </link>

    <link name="gripper_finger_right">
        <visual>
            <origin xyz="${gripper_finger_length/2} 0 0" rpy="0.0 0.0 0.0"/>
            <geometry>  
                <box size="${gripper_finger_length} ${gripper_finger_width} ${gripper_finger_height}"/>
            </geometry>
            <material name="blue"/>
        </visual>
    </link>

    <joint name="third_link_gripper_base" type="fixed">
        <parent link="third_link"/>
        <child link="gripper_base"/>
        <origin xyz="${third_link_length/2} 0 0" rpy="0.0 0.0 0.0"/>
    </joint>

    <!-- <joint name="gripper_base_finger_left" type="prismatic">
        <parent link="gripper_base"/>
        <child link="gripper_finger_left"/>
        <origin xyz="${gripper_base_length/2} ${gripper_base_width/2} 0" rpy="0.0 0.0 0.0"/>
        <axis xyz="0 0 1"/>
        <limit lower="0.0" upper="${gripper_base_length/2}" effort="1" velocity="1"/>
    </joint>

    <joint name="gripper_base_finger_right" type="prismatic">
        <parent link="gripper_base"/>
        <child link="gripper_finger_right"/>
        <origin xyz="${gripper_base_length/2} $-{gripper_base_width/2} 0" rpy="0.0 0.0 0.0"/>
        <axis xyz="0 0 1"/>
        <limit lower="0" upper="-${gripper_base_length/2}" effort="1" velocity="1"/>
    </joint> -->

</robot>