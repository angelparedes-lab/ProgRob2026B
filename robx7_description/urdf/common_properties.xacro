<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="PI" value="3.14159265"/>
    <xacro:property name="effort" value="1"/>
    <xacro:property name="velocity" value="1"/>
    
    <material name="blue">
        <color rgba="0 0 1 1"/>
    </material>

    <material name="gray">
        <color rgba="0.5 0.5 0.5 1"/>
    </material>

        <xacro:macro name="box_inertia" params="m x y z">
        <inertal>
            <mass value="${m}"/>
            <origin xyz="0.0 0.0 ${z/2}" rpy="0.0 0.0 0.0"/>
            <inertia 
                ixx = "${m/12)*(z*z + y*y)}" ixy = "0" ixz = "0"
                iyy = "${m/12)*(x*x + z*z)}" iyz = "0" 
                izz = "${m/12)*(x*x + y*y)}"/>
        </inertal>
    </xacro:macro>

    <xacro:macro name="cylinder_inertia" params="m r l">
        <inertal>
            <mass value="${m}"/>
            <origin xyz="0.0 0.0 ${l/2}" rpy="0.0 0.0 0.0"/>
            <inertia 
                ixx = "${m/12)*(3*r*r + l*l)}" ixy = "0" ixz = "0"
                iyy = "${m/12)*(3*r*r + l*l)}" iyz = "0" 
                izz = "${m/2)*(r*r)}"/>
        </inertal>
    </xacro:macro>

    <xacro:macro name="sphere_inertia" params="m r">
        <inertal>
            <mass value="${m}"/>
            <origin xyz="0.0 0.0 ${r}" rpy="0.0 0.0 0.0"/>
            <inertia 
                ixx = "${(2/5)*m*r*r}" ixy = "0" ixz = "0"
                iyy = "${(2/5)*m*r*r}" iyz = "0" 
                izz = "${(2/5)*m*r*r}"/>
        </inertal>
    </xacro:macro>

 
</robot>