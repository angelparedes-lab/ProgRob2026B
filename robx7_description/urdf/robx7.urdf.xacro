<robot name="robx7" xmlns:xacro="http://www.ros.org/wiki/xacro">
    
    <xacro:arg name="use_gazebo" default="false"/>

    <xacro:include filename="common_properties.xacro"/> 
    <xacro:include filename="robx7_arm.xacro"/>
    <xacro:include filename="robx7_gripper.xacro"/>
    <xacro:include filename="robx7_gazebo.xacro"/>
    <xacro:include filename="robx7_camera.xacro"/>

</robot>