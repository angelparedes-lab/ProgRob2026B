<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="camera_x" value="0.65"/>
    <xacro:property name="camera_y" value="0.0"/>
    <xacro:property name="camera_z" value="0.8"/>

    <xacro:property name="camera_width_px" value="640"/>
    <xacro:property name="camera_height_px" value="480"/>
    <xacro:property name="camera_hfov" value="1.2"/> <!-- Horizontal field of view radians -->
    <xacro:property name="camera_rate" value="15"/> <!-- Hz -->

    <link name="camera_link">
        <visual>
            <geometry>
                <box size="0.05 0.08 0.05"/>
            </geometry>
            <material name="gray"/>
        </visual>
        <xacro:box_inertia m="0.05" x="0.05" y="0.08" z="0.05" o_xyz="0 0 0" o_rpy="0 0 0"/>
    </link>

    <link name="camera_optical_link"/>

    <joint name="world_camera_joint" type="fixed">
        <parent link="world"/>
        <child link="camera_link"/>
        <origin xyz="${camera_x} ${camera_y} ${camera_z}" rpy="0 ${PI/2} 0"/>
    </joint>

    <joint name="camera_optical_joint" type="fixed">
        <parent link="camera_link"/>
        <child link="camera_optical_link"/>
        <origin xyz="0 0 0" rpy="${-PI/2} 0 ${-PI/2}"/>
    </joint>

    <xacro:if value="$(arg use_gazebo)">
        <gazebo reference="camera_link">
            <sensor type="camera" name="camera">
                <always_on>true</always_on>
                <update_rate>${camera_rate}</update_rate>
                <topic>camera</topic>
                <ignition_frame_id>camera_optical_link</ignition_frame_id>
                <camera>
                    <horizontal_fov>${camera_hfov}</horizontal_fov>
                    <image>
                        <width>${camera_width_px}</width>
                        <height>${camera_height_px}</height>
                        <format>R8G8B8</format>
                    </image>
                    <clip>
                        <near>0.05</near>
                        <far>5.0</far>
                    </clip>
                </camera>
            </sensor>
        </gazebo>
    </xacro:if>

</robot>