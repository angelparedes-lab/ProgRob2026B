<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    
    <xacro:property name="base_link_length" value="0.3"/>
    <xacro:property name="base_link_width" value="0.3"/>
    <xacro:property name="base_link_height" value="0.1"/>
    <xacro:property name="base_link_mass" value="0.1"/>

    <xacro:property name="firts_link_length" value="0.1"/>
    <xacro:property name="firts_link_radius" value="0.05"/>
    <xacro:property name="first_link_mass" value="1.0"/>
    
    <xacro:property name="second_link_length" value="0.4"/>
    <xacro:property name="second_link_radius" value="0.05"/>
    <xacro:property name="second_link_mass" value="1.0"/>
    <xacro:property name="second_link_rpy" value="0.0 ${PI/2} 0.0"/>
    
    <xacro:property name="third_link_length" value="0.3"/>
    <xacro:property name="third_link_radius" value="0.05"/>
    <xacro:property name="third_link_mass" value="1.0"/>
    <xacro:property name="third_link_rpy" value="0.0 ${PI/2} 0.0"/>


    <link name="world"/>

    <link name="base_link">
        <visual>
            <origin xyz="0.0 0.0 ${base_link_height/2}" rpy="0.0 0.0 0.0"/>
            <geometry>  
                <box size="${base_link_length} ${base_link_width} ${base_link_height}"/>
            </geometry>
            <material name="gray"/>
        </visual>
        <xacro:box_inertia m="${base_link_mass}" x="${base_link_length}" y="${base_link_width}" z="${base_link_height}" o_xyz="0.0 0.0 ${base_link_height/2}" o_rpy="0.0 0.0 0.0"/>
        <collision>
            <origin xyz="0.0 0.0 ${base_link_height/2}" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="${base_link_length} ${base_link_width} ${base_link_height}"/>
            </geometry>
        </collision>
    </link> 
    
     <link name="first_link">
        <visual>
            <origin xyz="0.0 0.0 ${firts_link_length/2}" rpy="0.0 0.0 0.0"/>
            <geometry>  
                <cylinder radius="${firts_link_radius}" length="${firts_link_length}"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <xacro:cylinder_inertia m="${first_link_mass}" r="${firts_link_radius}" l="${firts_link_length}" o_xyz="0.0 0.0 ${firts_link_length/2}" o_rpy="0.0 0.0 0.0"/>
        <collision>
            <origin xyz="0.0 0.0 ${firts_link_length/2}" rpy="0.0 0.0 0.0"/>
            <geometry>
                <cylinder radius="${firts_link_radius}" length="${firts_link_length}"/>
            </geometry>
        </collision>
    </link> 

    <link name="second_link">
        <visual>
            <origin xyz="${second_link_length/2} 0.0 0.0" rpy="${second_link_rpy}"/>
            <geometry>  
                <cylinder radius="${second_link_radius}" length="${second_link_length}"/>
            </geometry>
            <material name="gray"/>
        </visual> 
        <xacro:cylinder_inertia m="${second_link_mass}" r="${second_link_radius}" l="${second_link_length}" o_xyz="${second_link_length/2} 0.0 0.0" o_rpy="${second_link_rpy}"/>
        <collision>
            <origin xyz="${second_link_length/2} 0.0 0.0" rpy="${second_link_rpy}"/>
            <geometry>
                <cylinder radius="${second_link_radius}" length="${second_link_length}"/>
            </geometry>
        </collision>
    </link>


    <link name="third_link">
        <visual>
            <origin xyz="${third_link_length/2} 0.0 0.0" rpy="${third_link_rpy}"/>
            <geometry>  
                <cylinder radius="${third_link_radius}" length="${third_link_length}"/>
            </geometry>
            <material name="blue"/>
        </visual> 
        <xacro:cylinder_inertia m="${third_link_mass}" r="${third_link_radius}" l="${third_link_length}" o_xyz="${third_link_length/2} 0.0 0.0" o_rpy="${third_link_rpy}"/>
        <collision>
            <origin xyz="${third_link_length/2} 0.0 0.0" rpy="${third_link_rpy}"/>
            <geometry>
                <cylinder radius="${third_link_radius}" length="${third_link_length}"/>
            </geometry>
        </collision>
    </link>

    <joint name="world_base_joint" type="fixed">
        <parent link="world"/>
        <child link="base_link"/>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
    </joint>

    <joint name="base_first_joint" type="revolute">
        <parent link="base_link"/>
        <child link="first_link"/>
        <origin xyz = "0.0 0.0 ${base_link_height}" rpy = "0.0 0.0 0.0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-${PI}" upper="${PI}" effort="${effort}" velocity="${velocity}"/>
    </joint>

    <joint name="first_second_joint" type="revolute">
        <parent link="first_link"/>
        <child link="second_link"/>
        <origin xyz = "0.0 0.0 ${firts_link_length}" rpy = "-${PI/2} -${PI/2} 0.0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-${PI/2}" upper="${PI/2}" effort="${effort}" velocity="${velocity}"/>
    </joint>

    <joint name="second_third_joint" type="revolute">
        <parent link="second_link"/>
        <child link="third_link"/>
        <origin xyz = "${second_link_length} 0.0 0.0" rpy = "0 0 0.0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-${PI/2}" upper="${PI/2}" effort="${effort}" velocity="${velocity}"/>
    </joint>

</robot>